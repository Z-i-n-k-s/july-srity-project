REACT_APP_BACKEND_URL=http://localhost:8080
REACT_APP_CLOUD_NAME_CLOUDINARY=

# Required for the interactive click-to-pin Google Map.
# Without a key, the forms still show a Google Maps preview and current-location coordinates.
REACT_APP_GOOGLE_MAPS_API_KEY=

# Keep false in normal development and production. Admin pages never use mock records.
REACT_APP_DEMO_FALLBACK=false
